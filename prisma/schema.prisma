// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN

  @@map("stock_status_enum")
}

model Brand {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceBrandId String?        @unique @map("source_brand_id")
  name          String
  slug          String?        @unique
  createdAt     DateTime?      @map("created_at")
  updatedAt     DateTime?      @map("updated_at")
  productRanges ProductRange[]
  products      Product[]

  @@map("brand")
}

model Family {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFamilyId String      @unique @map("source_family_id")
  name           String
  createdAt      DateTime?   @map("created_at")
  updatedAt      DateTime?   @map("updated_at")
  products       Product[]
  subfamilies    Subfamily[]

  @@map("family")
}

model Subfamily {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceSubfamilyId String    @unique @map("source_subfamily_id")
  familyId          String    @map("family_id") @db.Uuid
  name              String
  createdAt         DateTime? @map("created_at")
  updatedAt         DateTime? @map("updated_at")
  family            Family    @relation(fields: [familyId], references: [id])
  products          Product[]

  @@map("subfamily")
}

model ProductRange {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId     String?        @map("brand_id") @db.Uuid
  name        String
  slug        String?        @unique
  description String?        @db.Text
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime?      @map("created_at")
  updatedAt   DateTime?      @map("updated_at")
  brand       Brand?         @relation(fields: [brandId], references: [id])
  products    Product[]
  images      ProductImage[] @relation("ProductRangeImages")

  @@map("product_range")
}

model Product {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  erpCode          String         @unique @map("erp_code")
  erpName          String         @map("erp_name")
  commerceName     String?        @map("commerce_name")
  slug             String?        @unique
  brandId          String?        @map("brand_id") @db.Uuid
  familyId         String?        @map("family_id") @db.Uuid
  subfamilyId      String?        @map("subfamily_id") @db.Uuid
  rangeId          String?        @map("range_id") @db.Uuid
  shortDescription String?        @map("short_description") @db.Text
  longDescription  String?        @map("long_description") @db.Text
  isPublished      Boolean        @default(false) @map("is_published")
  price            Decimal?       @db.Decimal(12, 2)
  vatRate          Decimal?       @map("vat_rate") @db.Decimal(5, 2)
  priceSyncedAt    DateTime?      @map("price_synced_at")
  stockQuantity    Decimal?       @map("stock_quantity") @db.Decimal(14, 3)
  stockStatus      StockStatus?   @map("stock_status")
  stockSyncedAt    DateTime?      @map("stock_synced_at")
  importedFromDwAt DateTime?      @map("imported_from_dw_at")
  createdAt        DateTime?      @map("created_at")
  updatedAt        DateTime?      @map("updated_at")
  brand            Brand?         @relation(fields: [brandId], references: [id])
  family           Family?        @relation(fields: [familyId], references: [id])
  subfamily        Subfamily?     @relation(fields: [subfamilyId], references: [id])
  range            ProductRange?  @relation(fields: [rangeId], references: [id])
  images           ProductImage[] @relation("ProductImages")

  @@map("product")
}

model ProductImage {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  rangeId         String?       @map("range_id") @db.Uuid
  storageKey      String        @map("storage_key")
  source          String?
  sourceReference String?       @map("source_reference")
  altText         String?       @map("alt_text")
  sortOrder       Int           @default(0) @map("sort_order")
  isPrimary       Boolean       @default(false) @map("is_primary")
  createdAt       DateTime?     @map("created_at")
  product         Product?      @relation("ProductImages", fields: [productId], references: [id])
  range           ProductRange? @relation("ProductRangeImages", fields: [rangeId], references: [id])

  @@map("product_image")
}
